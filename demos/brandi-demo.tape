# Generated by Brandi — Show how Brandi delivers Keep every outward expression of a product aligned with its identity.
Output demos/brandi-demo.gif

Require brandi

Set Shell "bash"
Set Theme "CyberPunk2077"
Set Width 1200
Set Height 720
Set FontSize 28
Set TypingSpeed 35ms
Set Margin 24
Set MarginFill "#160812"

# Inspect the brand system
Type "brandi scan" Enter
Sleep 1800ms

# Measure coherence
Type "brandi lint" Enter
Sleep 1800ms

# Turn findings into action
Type "brandi propose --budget 5" Enter
Sleep 1800ms

